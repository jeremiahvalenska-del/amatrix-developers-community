@app.route('/form/confirm', methods=['POST'])
def confirm():
    init_db(); db=get_db(); s=get_stats(); header=HEADER(s)
    d = {k: request.form.get(k,'').strip() for k in ['nom','age','ville','pays','whatsapp','niveau','langages','outils','projets','liens_projets','motivation','competences','disponibilite']}
    print("FORM DATA RECU:", d)
    cid=str(uuid.uuid4())
    try: age=int(d.get('age',0) or 0)
    except: age=0
    try:
        db.execute("INSERT INTO candidatures(id,nom,age,ville,pays,whatsapp,niveau,langages,outils,projets,liens_projets,experience,motivation,competences,disponibilite,statut,created_at,pays_lower,ville_lower) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",(cid,d.get('nom'),age,d.get('ville'),d.get('pays'),d.get('whatsapp'),d.get('niveau'),d.get('langages'),d.get('outils'),d.get('projets'),d.get('liens_projets'),'',d.get('motivation'),d.get('competences'),d.get('disponibilite'),'Enregistree',datetime.datetime.now().isoformat(),d.get('pays','').lower(),d.get('ville','').lower()))
        db.commit()
        print("INSERT OK CID:", cid)
    except Exception as e:
        print("ERREUR INSERT:", e)
        return render_template_string(BASE_CSS + header + f"<div class='page'><h2>Erreur: {e}</h2><a href='/form'>Retour</a></div>")

    msg = build_whatsapp(d)
    wa_direct = f"https://wa.me/?text={urllib.parse.quote(msg, safe='')}"
    total_new = s["total"]+1
    return render_template_string(BASE_CSS + header + f"""
<div class="form-wrap" style="text-align:center">
<h2>✅ Candidature enregistree !</h2>
<p>ID: {cid}</p><p>Total membres: {total_new}</p>
<div style="background:#e6fffa;border:1px solid #00a36a;padding:14px;border-radius:12px;margin:14px 0">
<p style="font-size:13px;color:#0a5a3a;font-weight:700">✅ Enregistre avec succes - Pas de blocage</p>
</div>
<a href="{wa_direct}" target="_blank" style="display:block;background:#25D366;color:#fff;padding:16px;border-radius:24px;text-decoration:none;font-weight:800;margin-bottom:12px">💬 ENVOYER DANS GROUPE RECRUTEMENT - Clavier direct</a>
<a href="{LINKS['recrutement']}" target="_blank" style="display:block;background:#2a5bd7;color:#fff;padding:12px;border-radius:24px;text-decoration:none;font-weight:700">👥 REJOINDRE GROUPE RECRUTEMENT</a>
<br><br><a href="/">Accueil</a> | <a href="/membres">Voir membres: {total_new}</a>
</div>
<script>setTimeout(()=>{{window.open("{wa_direct}", "_blank")}}, 700);</script>
""")

@app.route('/membres')
def membres():
    init_db(); db=get_db(); s=get_stats(); header=HEADER(s); rows=db.execute("SELECT * FROM candidatures ORDER BY created_at DESC").fetchall()
    html="".join([f"<div class='card'><b>{r['nom']}</b> - {r['ville']}/{r['pays']} - {r['whatsapp']}</div>" for r in rows]) or "<p>Aucun membre encore</p>"
    return render_template_string(BASE_CSS + header + f"<div class='page'><h2>Membres: {s['total']}</h2>{html}<br><a href='/'>Accueil</a></div>")

