def index():
    init_db(); s=get_stats(); header=HEADER(s)
    return render_template_string(BASE_CSS + header + f"""
<div class="page"><h1>AMATRIX Community - {s['total']} membres</h1><p>Construis ton avenir avec nous</p><br>
<a href="/form" style="background:#00c897;color:#002a1a;padding:13px 20px;border-radius:24px;font-weight:800;text-decoration:none">S'inscrire maintenant</a><br><br>
<a href="/annonces" style="background:#0a1930;color:#fff;padding:10px 18px;border-radius:20px;text-decoration:none">Annonces</a>
<a href="/apropos" style="background:#0a1930;color:#fff;padding:10px 18px;border-radius:20px;text-decoration:none;margin-left:8px">A propos</a>
</div>
""")

