import os, sqlite3, datetime, uuid, urllib.parse
from flask import Flask, request, render_template_string, redirect, session, g
from werkzeug.security import generate_password_hash, check_password_hash

app = Flask(__name__)
app.secret_key = 'amatrix-direct-no-block-2025'
DATABASE='amatrix.db'
LINKS={
 'chaine':'https://whatsapp.com/channel/0029VbDMH24FSAtCHZ5smv20',
 'recrutement':'https://chat.whatsapp.com/CYcNxrmW7lH6XrLRU20hxS?s=cl&p=a&mlu=4&ilr=4',
 'communaute':'https://chat.whatsapp.com/K2fYZpLSk1a81qFKy3yNZN'
}

def get_db():
    db=getattr(g,'_database',None)
    if db is None:
        db=g._database=sqlite3.connect(DATABASE)
        db.row_factory=sqlite3.Row
    return db

def init_db():
    db=sqlite3.connect(DATABASE)
    c=db.cursor()
    c.executescript("""
    CREATE TABLE IF NOT EXISTS candidatures(id TEXT PRIMARY KEY, nom TEXT, age INTEGER, ville TEXT, pays TEXT, whatsapp TEXT, niveau TEXT, langages TEXT, outils TEXT, projets TEXT, liens_projets TEXT, experience TEXT, motivation TEXT, competences TEXT, disponibilite TEXT, statut TEXT, created_at TEXT, pays_lower TEXT, ville_lower TEXT);
    CREATE TABLE IF NOT EXISTS users(id TEXT PRIMARY KEY, username TEXT UNIQUE, password_hash TEXT, role TEXT);
    CREATE TABLE IF NOT EXISTS annonces(id TEXT PRIMARY KEY, titre TEXT, description TEXT, image TEXT, categorie TEXT, statut TEXT, date TEXT);
    CREATE TABLE IF NOT EXISTS assistance(id TEXT PRIMARY KEY, nom TEXT, whatsapp TEXT, message TEXT, date TEXT);
    """)
    if not c.execute("SELECT * FROM users WHERE username='admin'").fetchone():
        c.execute("INSERT INTO users VALUES (?,?,?,?)",(str(uuid.uuid4()),'admin',generate_password_hash("AMATRIX 900 9-9 Pro"),'admin_principal'))
    db.commit(); db.close()

def get_stats():
    db=get_db()
    try:
        total=db.execute("SELECT COUNT(*) FROM candidatures").fetchone()[0]
        pays=db.execute("SELECT COUNT(DISTINCT pays_lower) FROM candidatures WHERE pays_lower!=''").fetchone()[0] or 0
        villes=db.execute("SELECT COUNT(DISTINCT ville_lower) FROM candidatures WHERE ville_lower!=''").fetchone()[0] or 0
        week=db.execute("SELECT COUNT(*) FROM candidatures WHERE created_at>=?",((datetime.datetime.now()-datetime.timedelta(days=7)).isoformat(),)).fetchone()[0] or 0
    except: total=pays=villes=week=0
    return dict(total=total,pays=pays,villes=villes,week=week)

def build_whatsapp(d):
    now = datetime.datetime.now().strftime('%d/%m/%Y %H:%M')
    return f"AMATRIX - FORMULAIRE RECRUTEMENT\nDate: {now}\nNom: {d.get('nom','')}\nAge: {d.get('age','')}\nVille: {d.get('ville','')}\nPays: {d.get('pays','')}\nWhatsApp: {d.get('whatsapp','')}\nNiveau: {d.get('niveau','')}\nLangages: {d.get('langages','')}\nOutils: {d.get('outils','')}\nProjets: {d.get('projets','')}\nLiens: {d.get('liens_projets','')}\nMotivation: {d.get('motivation','')}\nCompetences: {d.get('competences','')}\nDispo: {d.get('disponibilite','')}\nGroupe: {LINKS['recrutement']}"

def HEADER(s):
    return f"""
<header style="background:#091a35;display:flex;justify-content:space-between;padding:10px 14px;position:sticky;top:0;z-index:200;color:#fff"><div>AMATRIX community</div><a href="/" style="color:#fff;text-decoration:none">🏠 Accueil</a></header>
"""

BASE_CSS = """
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<style>
*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui;background:#f6f8ff}
.form-wrap{max-width:840px;margin:20px auto;background:#fff;border-radius:18px;padding:24px;border:1px solid #e2eaff}
.form-wrap label{font-size:12px;font-weight:700;display:block;margin:14px 0 5px} .form-wrap input,.form-wrap select,.form-wrap textarea{width:100%;padding:12px;border-radius:12px;border:1px solid #d0d8ea;font-size:13px}
.card{border:1px solid #e2eaff;border-radius:12px;padding:14px;background:#fff;margin:8px 0}
.page{max-width:1100px;margin:0 auto;background:#fff;min-height:80vh;padding:20px}
</style>
"""

@app.before_request
def before(): g.db=get_db()
@app.teardown_appcontext
def close(e):
    db=getattr(g,'_database',None)
    if db: db.close()

