@app.route('/admin', methods=['GET','POST'])
def admin():
    init_db()
    if request.method=='POST':
        from werkzeug.security import check_password_hash
        u=request.form.get('username',''); p=request.form.get('password',''); db=get_db(); r=db.execute("SELECT * FROM users WHERE username=?",(u,)).fetchone()
        if r and check_password_hash(r['password_hash'],p): session['admin']=r['username']; return redirect('/admin/dashboard')
    return render_template_string(BASE_CSS+'<div style="max-width:400px;margin:80px auto;background:#fff;padding:20px;border-radius:16px"><h2>Admin</h2><form method="POST"><input name="username" value="admin" required style="width:100%;padding:10px"><input name="password" type="password" required style="width:100%;padding:10px;margin-top:8px"><button style="width:100%;background:#2a5bd7;color:#fff;padding:10px;margin-top:10px" type="submit">Login</button></form></div>')

@app.route('/admin/dashboard')
def dash():
    init_db()
    if 'admin' not in session: return redirect('/admin')
    db=get_db(); s=get_stats(); rows=db.execute("SELECT * FROM candidatures ORDER BY created_at DESC").fetchall()
    html="".join([f"<div class='card'><b>{r['nom']}</b> {r['ville']} {r['whatsapp']}</div>" for r in rows])
    return render_template_string(BASE_CSS + f"<div class='page'><h2>Dashboard {s['total']} membres</h2>{html}<br><a href='/'>Site</a></div>")

@app.route('/admin/logout')
def logout(): session.clear(); return redirect('/admin')

